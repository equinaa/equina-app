{
  "name": "equina-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run-tests.ts",
    "backend:check": "npx deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "backend:audit": "tsx scripts/backend-schema-audit.ts",
    "security:bundle-scan": "tsx scripts/scan-client-secrets.ts",
    "seed:print": "tsx src/seed/seed-data.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "~55.0.28",
    "expo-apple-authentication": "~55.0.15",
    "expo-asset": "~55.0.18",
    "expo-auth-session": "~55.0.17",
    "expo-blur": "~55.0.16",
    "expo-clipboard": "~55.0.15",
    "expo-crypto": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-document-picker": "~55.0.15",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.16",
    "expo-image-picker": "~55.0.22",
    "expo-linear-gradient": "~55.0.16",
    "expo-notifications": "~55.0.25",
    "expo-secure-store": "~55.0.16",
    "expo-video": "~55.0.19",
    "expo-web-browser": "~55.0.18",
    "lucide-react-native": "^1.14.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "playwright": "^1.59.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
