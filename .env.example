# Safe to include in an Expo client bundle.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Use magic-link with Supabase's default mailer. Switch to otp after custom SMTP is configured.
EXPO_PUBLIC_EQUINA_EMAIL_AUTH_MODE=magic-link

# Compile-time emergency switches. Server rollout flags and authorization are still required.
EXPO_PUBLIC_ENABLE_APPLE_AUTH=false
EXPO_PUBLIC_ENABLE_GOOGLE_AUTH=false
EXPO_PUBLIC_ENABLE_ACCOUNT_SETTINGS=true
EXPO_PUBLIC_ENABLE_COACH_CHAT=false
EXPO_PUBLIC_ENABLE_SHOP_MESSAGING=false
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
EXPO_PUBLIC_ENABLE_HORSE_MANAGEMENT=false
EXPO_PUBLIC_ENABLE_RECORD_MUTATIONS=false
EXPO_PUBLIC_ENABLE_RIDE_LOGGING=false
EXPO_PUBLIC_ENABLE_CLUB_INTERACTIONS=false
EXPO_PUBLIC_ENABLE_CLUB_PUBLISHING=false
EXPO_PUBLIC_ENABLE_SHOP_LISTING_CREATION=false
EXPO_PUBLIC_ENABLE_SHOP_TRANSACTIONS=false
EXPO_PUBLIC_EAS_PROJECT_ID=e42e13a7-0029-41ca-9d7e-3bb6af63a8a1

# Development only. Keep false or unset in production builds.
EXPO_PUBLIC_EQUINA_DEMO_MODE=false

# Edge Function secrets. Set with `supabase secrets set`; never place these in Expo env.
SUPABASE_SERVICE_ROLE_KEY=SET_IN_SUPABASE_ONLY
STRIPE_SECRET_KEY=SET_IN_SUPABASE_ONLY
STRIPE_WEBHOOK_SECRET=SET_IN_SUPABASE_ONLY
MARKETPLACE_TERMS_VERSION=2026-07-21
MARKETPLACE_FEE_BPS=800
CONNECT_RETURN_URL=equina://seller/return
CONNECT_REFRESH_URL=equina://seller/refresh
ORDER_AUTOMATION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
ACCOUNT_AUTOMATION_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
NOTIFICATION_AUTOMATION_SECRET=GENERATE_ANOTHER_LONG_RANDOM_SECRET
MODERATION_AUTOMATION_SECRET=GENERATE_A_SEPARATE_LONG_RANDOM_SECRET
STORAGE_AUTOMATION_SECRET=GENERATE_ONE_MORE_LONG_RANDOM_SECRET
SENTRY_DSN=SET_IN_SUPABASE_ONLY

# Upload inspection boundary. Keep MALWARE_SCAN_REQUIRED=true for public
# production rollouts; internal rollout may remain false until the scanner
# endpoint has been provisioned and tested.
MALWARE_SCAN_URL=https://YOUR_PRIVATE_SCANNER/scan
MALWARE_SCAN_TOKEN=SET_IN_SUPABASE_ONLY
MALWARE_SCAN_REQUIRED=true

# Ralf provider boundary. EQUINA_AI_API_URL must accept an OpenAI-compatible
# request body. These values belong only in Supabase Edge Function secrets.
EQUINA_AI_API_URL=https://YOUR_AI_PROVIDER/v1/responses
EQUINA_AI_API_KEY=SET_IN_SUPABASE_ONLY
EQUINA_AI_MODEL=SET_IN_SUPABASE_ONLY
EQUINA_AI_DEVELOPMENT_FALLBACK=false

# Optional for Expo projects configured to require push access tokens.
EXPO_ACCESS_TOKEN=SET_IN_SUPABASE_ONLY

# Academy lesson videos (Bunny Stream). academy-playback signs every link with
# the library's token authentication key; without these two, lessons show
# "video unavailable" rather than failing. Token authentication must be on
# for the library's CDN, or a video id alone would play.
BUNNY_STREAM_CDN_HOSTNAME=vz-YOUR_LIBRARY.b-cdn.net
BUNNY_STREAM_TOKEN_KEY=SET_IN_SUPABASE_ONLY

# Required before Club publishing or marketplace listing publishing is enabled.
CONTENT_MODERATION_URL=https://YOUR_MODERATION_ADAPTER/review
CONTENT_MODERATION_TOKEN=SET_IN_SUPABASE_ONLY

# Required before business-seller checkout is enabled.
TAX_QUOTE_URL=https://YOUR_TAX_ADAPTER/quote
TAX_QUOTE_TOKEN=SET_IN_SUPABASE_ONLY
