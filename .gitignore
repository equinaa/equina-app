.vercel
.env
.env.*
!.env.example
.expo/
dist/
# Generated by `expo prebuild`. Regenerated from app.json, so the sources of
# truth are app.json and the config plugins, never the checked-in native code.
# Only the root ones: modules/*/ios is the app's own native module, kept.
/ios/
/android/
# Written into each target's folder by @bacons/apple-targets at prebuild, from
# the colours in its expo-target.config.json.
targets/*/Assets.xcassets/
node_modules/
supabase/functions/node_modules/
supabase/.temp/
.DS_Store
.env*
!.env.example
# Local worktrees, screenshots and working files. EAS uploads everything this
# file does not ignore, and it never reads a global gitignore: without this
# line a build from the main checkout sends the whole folder to Expo.
.claude/
