# The same Supabase project the app uses. Only the publishable key: the admin
# acts with each staff member's own session, so it never needs the service
# role key, and must never be given it.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
