{
  "expo": {
    "name": "Equina",
    "slug": "equina",
    "owner": "alexkato88",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "equina",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "d6c22d07-33b0-45f9-a250-334940fdb50f"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Equina uses the photos you choose for your profile, your horses and Club posts.",
          "cameraPermission": "Equina does not use the camera.",
          "microphonePermission": "Equina does not use the microphone."
        }
      ],
      "expo-video",
      "expo-asset",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Equina does not use Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "./plugins/with-storekit-configuration.cjs",
      [
        "expo-audio",
        {
          "microphonePermission": "Equina does not use the microphone.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.equina.mobile",
      "config": {
        "usesNonExemptEncryption": false
      },
      "splash": {
        "backgroundColor": "#161512",
        "image": "./assets/splash.png"
      }
    },
    "android": {
      "package": "com.equina.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "backgroundColor": "#161512",
      "splash": {
        "backgroundColor": "#161512"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#161512"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro"
    }
  }
}
