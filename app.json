{
  "expo": {
    "name": "Equina",
    "slug": "equina",
    "owner": "alexkato88",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "equina",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "d6c22d07-33b0-45f9-a250-334940fdb50f"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Equina uses the photos you choose for your profile, your horses and Club posts.",
          "cameraPermission": "Equina does not use the camera.",
          "microphonePermission": "Equina uses the microphone only while you hold the mic to ask Ralf a question. What you say becomes text on your phone."
        }
      ],
      "expo-video",
      "expo-asset",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Equina does not use Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "sounds": [
            "./assets/sounds/ride_phase.wav",
            "./assets/sounds/ride_done.wav"
          ]
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "./plugins/with-storekit-configuration.cjs",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Equina uses the microphone only while you hold the mic to ask Ralf a question. What you say becomes text on your phone.",
          "speechRecognitionPermission": "Equina turns what you say to Ralf into text, on your phone, while you hold the mic."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Equina uses the microphone only while you hold the mic to ask Ralf a question. What you say becomes text on your phone.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.equina.mobile",
      "config": {
        "usesNonExemptEncryption": false
      },
      "splash": {
        "backgroundColor": "#4E301B",
        "image": "./assets/splash.png"
      }
    },
    "android": {
      "package": "com.equina.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "backgroundColor": "#4E301B",
      "splash": {
        "backgroundColor": "#4E301B"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#4E301B"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro"
    }
  }
}
